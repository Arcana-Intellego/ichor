# Active learning daemon runtime artifacts:
#
# .DATA/ covers state.json, journal.ndjson,
# recent_seeds.json, seed_frame_id_index.json, and the various
# *.lock files since the daemon writes them all under
# <campaign>/.DATA/ACTIVE_LEARNING/.
# The patterns below cover the
# campaign root subtrees that hold committed iterations and the
# per-pointdir sidecars that live outside .DATA/.

/BOOTSTRAP/
/3_DIVERSITY_SAMPLING/
/5_TRAINING/
/QM_REFERENCE_DATA/
/TRAINED_MODELS/
# Obsolete runtime root; kept ignored so an old campaign cannot be committed.
/6_TRAINED_MODELS/
/ACTIVE_LEARNING/
/7_ACTIVE_LEARNING/
/examples/**/BOOTSTRAP/
/examples/**/3_DIVERSITY_SAMPLING/
/examples/**/5_TRAINING/
/examples/**/QM_REFERENCE_DATA/
/examples/**/TRAINED_MODELS/
/examples/**/6_TRAINED_MODELS/
/examples/**/ACTIVE_LEARNING/
/examples/**/7_ACTIVE_LEARNING/
.provenance.json
.provenance.lock
daemon.lock
daemon.pid
.__ichor.lock

# Python tooling caches
.mypy_cache/
.ruff_cache/
